{
  "name": "gmt",
  "version": "6.7.0",
  "description": "The Generic Mapping Tools (GMT) library and gmt driver, built for MB-Studio",
  "homepage": "https://www.generic-mapping-tools.org",
  "license": "LGPL-3.0-or-later",
  "dependencies": [
    "curl",
    {
      "name": "fftw3",
      "default-features": false
    },
    {
      "name": "gdal",
      "default-features": false
    },
    {
      "name": "netcdf-c",
      "default-features": false,
      "features": [
        "netcdf-4"
      ]
    },
    "pcre2",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    "zlib"
  ]
}
