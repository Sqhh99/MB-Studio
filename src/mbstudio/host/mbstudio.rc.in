// MB-Studio executable resources: application icon and version information.
#include <winver.h>

IDI_APPICON ICON "@MBSTUDIO_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @MBSTUDIO_VERSION_COMMAS@,0
 PRODUCTVERSION  @MBSTUDIO_VERSION_COMMAS@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "MB-Studio contributors"
      VALUE "FileDescription",  "MB-Studio - desktop front end for MB-System"
      VALUE "FileVersion",      "@MBSTUDIO_VERSION@"
      VALUE "InternalName",     "mbstudio"
      VALUE "LegalCopyright",   "GPL-3.0-or-later; MB-System (c) MBARI and contributors"
      VALUE "OriginalFilename", "mbstudio.exe"
      VALUE "ProductName",      "MB-Studio"
      VALUE "ProductVersion",   "@MBSTUDIO_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
